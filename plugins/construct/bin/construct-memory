#!/usr/bin/env node
// construct-memory: the command line over the per-repository memory store (S5 of odd/tasks/construct-memory.md).
import { readFileSync, writeFileSync } from 'node:fs'
import { parseArgs } from 'node:util'

const USAGE = `usage: construct-memory <command> [options]

  save                              JSON on stdin: title, content, type, topic_key, session_id; text that looks like prompt injection is rejected
  search <query> [--type T] [--limit N] [--any]
  get <id> [--history]
  context
  update <id>                       JSON on stdin: title, content, type, topic_key, or find + replace
  delete <id> [--hard]              soft delete; --hard erases the observation and its earlier versions for good
  summary --session <id>            summary on stdin; stores it and ends the session (injection-like lines become [FILTERED])
  review list | review done <id>
  review passive [--days N] [--json]  live passive memories never read with get and at least N days old (default 30), oldest first; read-only, then consolidate or delete
  review stale [--json]             live memories whose Where: names repository paths that no longer exist, with the missing paths; read-only (a missing path alone does not make a memory wrong)
  prompts [--limit N]               list stored prompts (id, date, preview), newest first
  prompts --search <query> [--limit N]  find stored prompts by text, same lines
  prompts delete <id>               remove one stored prompt for good
  import <file> [--project <name>]  load one project of an engram export JSON file (versions 0.1.0, 0.2.0)
  export [file]                     write live observations, sessions, and prompts as JSON (stdout, or a new file) for backup or another clone
  suggest-topic-key                 JSON on stdin: type, title, content; prints a topic key such as bug/fix-login, writes nothing
  timeline <id> [--before N] [--after N]  the observations around one in its session (default 5 and 5), the focus marked with >
  pin <id> | unpin <id>             pinned observations always load in the session context and rank higher in search
  stats [--json] [--session <id>]   counts of observations, sessions, prompts, pending relations, last save, and the database size
  doctor [--json]                   read-only health checks (schema, integrity, search indexes, WAL, writable); exit 1 when one fails
  judge <judgment-id> <relation> [--reason T] [--evidence T] [--confidence 0..1]  record a verdict on a candidate printed after save (re-judging overwrites)
  judge-many                        JSON array on stdin (1-32 of judgment_id, relation, reason, evidence, confidence); all or nothing
  relations pending [--limit N] [--json]  pending relation candidates between live memories, newest first (default 20), to judge with judge or judge-many
  compare <id-a> <id-b> <relation> --confidence 0..1 [--reasoning T]  record a verdict for any pair (a supersedes b)
                                    relations: related, compatible, scoped, conflicts_with, supersedes, not_conflict
  consolidate <id> <id>... --title T [--type T] [--topic-key K]  merge memories into one (content on stdin); prints a preview and a fingerprint, writes nothing
  consolidate <id> <id>... --title T --confirm <fingerprint>  with the same content: create the merged memory and soft-delete the sources
  help`

class UsageError extends Error {}
const fail = (message) => {
  throw new UsageError(message)
}

function stdinJson() {
  let value
  try {
    value = JSON.parse(readFileSync(0, 'utf8'))
  } catch {
    fail('invalid JSON on stdin')
  }
  if (value === null || typeof value !== 'object' || Array.isArray(value)) fail('stdin must be a JSON object')
  return value
}

function stdinArray() {
  let value
  try {
    value = JSON.parse(readFileSync(0, 'utf8'))
  } catch {
    fail('invalid JSON on stdin')
  }
  if (!Array.isArray(value)) fail('stdin must be a JSON array')
  return value
}

function idArg(text) {
  if (!/^\d+$/.test(text ?? '')) fail('an observation id (a number) is required')
  return Number(text)
}

function promptId(text) {
  if (!/^\d+$/.test(text ?? '')) fail('a prompt id (a number) is required')
  return Number(text)
}

const oneLine = (text) => String(text).replace(/\s+/g, ' ').trim()

function hit(row) {
  const parts = [`#${row.id}`, `[${row.type}]`, oneLine(row.title)]
  if (row.topic_key) parts.push(`(${row.topic_key})`)
  if (row.pinned) parts.push('pinned')
  if (row.needs_review) parts.push('needs_review')
  if (row.marks?.length) parts.push(...row.marks)
  return `${parts.join(' ')} - ${oneLine(row.preview)}${row.truncated ? '...' : ''}`
}

function show(row) {
  let out = `#${row.id} [${row.type}] ${oneLine(row.title)}\n`
  if (row.topic_key) out += `topic_key: ${row.topic_key}\n`
  out += `created: ${row.created_at}  updated: ${row.updated_at}  revisions: ${row.revision_count}  duplicates: ${row.duplicate_count}\n`
  out += `accessed: ${row.access_count}\n`
  if (row.session_id) out += `session: ${row.session_id}\n`
  if (row.needs_review) out += 'needs_review: yes\n'
  if (row.marks?.length) out += `relations: ${row.marks.join(', ')}\n`
  out += `\n${row.content}\n`
  if (row.versions) {
    out += `\n## history (${row.versions.length} earlier versions)\n`
    for (const v of row.versions) out += `\n--- version ${v.id} (${v.created_at}) [${v.type}] ${oneLine(v.title)}\n${v.content}\n`
  }
  return out
}

async function main(argv) {
  const [command, ...rest] = argv
  if (command === undefined || command === 'help' || command === '--help' || command === '-h') return `${USAGE}\n`
  const { values, positionals } = parseArgs({
    args: rest,
    allowPositionals: true,
    options: { type: { type: 'string' }, limit: { type: 'string' }, any: { type: 'boolean' }, history: { type: 'boolean' }, before: { type: 'string' }, after: { type: 'string' }, search: { type: 'string' }, hard: { type: 'boolean' }, json: { type: 'boolean' }, session: { type: 'string' }, project: { type: 'string' }, reason: { type: 'string' }, evidence: { type: 'string' }, confidence: { type: 'string' }, reasoning: { type: 'string' }, title: { type: 'string' }, 'topic-key': { type: 'string' }, confirm: { type: 'string' }, days: { type: 'string' } },
  })
  const known = ['save', 'search', 'get', 'context', 'update', 'delete', 'summary', 'review', 'import', 'prompts', 'export', 'suggest-topic-key', 'timeline', 'pin', 'unpin', 'stats', 'doctor', 'judge', 'judge-many', 'compare', 'relations', 'consolidate']
  if (!known.includes(command)) fail(`unknown command: ${command} (run construct-memory help)`)
  if (command === 'review' && !['list', 'done', 'stale', 'passive'].includes(positionals[0])) fail('review needs list, stale, passive, or done <id>')

  // Pre-approved prefixes (install.sh) end in `*`, so trailing words or options must never reach a destructive form:
  // each command takes only its own options, and delete, prompts delete, and review done run only in their exact shape.
  const options = Object.keys(values)
  const takes = { search: ['type', 'limit', 'any'], get: ['history'], timeline: ['before', 'after'], stats: ['json', 'session'], doctor: ['json'], review: ['json', 'days'], summary: ['session'], delete: ['hard'], import: ['project'], prompts: ['limit', 'search'], judge: ['reason', 'evidence', 'confidence'], compare: ['confidence', 'reasoning'], relations: ['limit', 'json'], consolidate: ['title', 'type', 'topic-key', 'confirm'] }[command] ?? []
  const stray = options.find((o) => !takes.includes(o))
  if (stray) fail(`${command} does not take --${stray}`)
  const sub = positionals[0]
  if (command === 'review' && options.includes('days') && sub !== 'passive') fail(`review ${sub} does not take --days`)
  if (command === 'delete' && positionals.length > 1) fail('delete takes one id')
  if (command === 'prompts' && sub === 'delete' && (options.length || positionals.length > 2)) fail('prompts delete takes one id and no options')
  if (command === 'review' && sub === 'done' && (options.length || positionals.length > 2)) fail('review done takes one id and no options')
  if (command === 'review' && sub === 'stale' && positionals.length > 1) fail('review stale takes only --json')
  if (command === 'review' && sub === 'passive' && positionals.length > 1) fail('review passive takes only --days and --json')
  if (command === 'review' && sub === 'list' && (options.length || positionals.length > 1)) fail('review list takes nothing else')
  if (command === 'prompts' && positionals.length && sub !== 'delete') fail('prompts needs nothing, or delete <id>')
  if (command === 'relations' && sub !== 'pending') fail('relations needs pending')
  if (command === 'relations' && positionals.length > 1) fail('relations pending takes only --limit and --json')
  if (command === 'import' && !positionals[0]) fail('import needs a file: construct-memory import <file> [--project <name>]')

  // Loaded here, not at the top: the store needs node:sqlite, and help and usage errors must work without it.
  let openMemory
  try {
    ;({ openMemory } = await import('../hooks/scripts/memory-store.mjs'))
  } catch {
    fail('memory needs node:sqlite with FTS5 (Node.js 22.16 or later; Node 23 is not supported)')
  }
  const store = openMemory(process.cwd())
  if (!store) fail('memory is off: not inside a git repository')
  try {
    switch (command) {
      case 'save': {
        const { id, action, candidates = [] } = store.save(stdinJson(), { candidates: true })
        return `saved #${id} (${action})\n${candidates.map((c) => `  candidate #${c.id} ${oneLine(c.title)} (judge: construct-memory judge ${c.judgment_id} <relation>)\n`).join('')}`
      }
      case 'search': {
        const query = positionals.join(' ')
        if (!query.trim()) fail('search needs a query')
        const rows = store.search(query, { type: values.type, limit: values.limit, any: values.any })
        return rows.length ? `${rows.map(hit).join('\n')}\n` : 'no memories found\n'
      }
      case 'get': {
        const id = idArg(positionals[0])
        const row = store.get(id, { history: values.history })
        if (!row) fail(`observation #${id} not found`)
        return show(row)
      }
      case 'context':
        return store.context()
      case 'update': {
        const id = idArg(positionals[0])
        const result = store.update(id, stdinJson())
        if (!result) fail(`observation #${id} not found`)
        return `${result.action} #${id}\n`
      }
      case 'delete': {
        const id = idArg(positionals[0])
        if (!store.remove(id, { hard: values.hard })) fail(`observation #${id} not found`)
        return `${values.hard ? 'erased' : 'deleted'} #${id}\n`
      }
      case 'summary': {
        if (!values.session) fail('summary needs --session <id>')
        const summary = readFileSync(0, 'utf8')
        if (!summary.trim()) fail('summary content is required on stdin')
        store.endSession(values.session, summary)
        return `summary saved, session ${values.session} ended\n`
      }
      case 'import': {
        let text
        try {
          text = readFileSync(positionals[0], 'utf8')
        } catch (error) {
          fail(`cannot read ${positionals[0]}: ${error.code ?? error.message}`)
        }
        let data
        try {
          data = JSON.parse(text)
        } catch {
          fail(`${positionals[0]} is not valid JSON`)
        }
        const n = store.importExport(data, { project: values.project })
        return `imported ${n.observations} observations, ${n.sessions} sessions, ${n.prompts} prompts; skipped ${n.skipped} already imported, ${n.deleted} deleted${n.relations ? `; ${n.relations} relations` : ''}\n`
      }
      case 'export': {
        const data = store.exportData()
        const json = `${JSON.stringify(data, null, 2)}\n`
        const file = positionals[0]
        if (!file) return json
        try {
          writeFileSync(file, json, { flag: 'wx' })
        } catch (error) {
          fail(error.code === 'EEXIST' ? `${file} already exists; choose a new file` : `cannot write ${file}: ${error.code ?? error.message}`)
        }
        return `exported ${data.observations.length} observations, ${data.sessions.length} sessions, ${data.prompts.length} prompts to ${file}\n`
      }
      case 'prompts': {
        if (positionals[0] === 'delete') {
          const id = promptId(positionals[1])
          if (!store.deletePrompt(id)) fail(`prompt #${id} not found`)
          return `deleted prompt #${id}\n`
        }
        if (values.search !== undefined && !values.search.trim()) fail('prompts --search needs a query')
        const rows = store.prompts({ limit: values.limit, search: values.search })
        if (values.search !== undefined && !rows.length) return 'no prompts found\n'
        return rows.length ? `${rows.map((r) => `#${r.id} ${r.created_at} ${[...oneLine(r.content)].slice(0, 120).join('')}`).join('\n')}\n` : 'no prompts stored\n'
      }
      case 'suggest-topic-key': {
        const input = stdinJson()
        for (const k of ['type', 'title', 'content']) if (input[k] !== undefined && typeof input[k] !== 'string') fail(`${k} must be a string`)
        if (!(input.title ?? '').trim() && !(input.content ?? '').trim()) fail('title or content is required')
        return `${store.suggestTopicKey(input)}\n`
      }
      case 'timeline': {
        const id = idArg(positionals[0])
        const t = store.timeline(id, { before: values.before, after: values.after })
        if (!t) fail(`observation #${id} not found`)
        const line = (mark, row) => `${mark} ${hit(row)}`
        return `${[
          `session ${t.session_id ?? '(none)'}: ${t.total} observations`,
          ...t.before.map((r) => line(' ', r)),
          line('>', t.focus),
          ...t.after.map((r) => line(' ', r)),
        ].join('\n')}\n`
      }
      case 'pin':
      case 'unpin': {
        const id = idArg(positionals[0])
        if (!store.pin(id, command === 'pin')) fail(`observation #${id} not found`)
        return `${command}ned #${id}\n`
      }
      case 'stats': {
        const s = store.stats({ session: values.session })
        if (values.json) return `${JSON.stringify(s)}\n`
        return `${[
          `observations: ${s.observations}`,
          `soft-deleted observations: ${s.deleted}`,
          `needing review: ${s.needing_review}`,
          `pinned observations: ${s.pinned}`,
          `sessions: ${s.sessions}`,
          `prompts: ${s.prompts}`,
          `database size: ${s.bytes} bytes`,
          `pending relations: ${s.pending_relations}`,
          `last save: ${s.last_save_at ?? 'never'}`,
          ...(s.session_saves === undefined ? [] : [`saved this session: ${s.session_saves}`]),
        ].join('\n')}\n`
      }
      case 'doctor': {
        const list = store.doctor()
        if (list.some((c) => !c.ok)) process.exitCode = 1
        return values.json ? `${JSON.stringify(list, null, 2)}\n` : `${list.map((c) => (c.ok ? `ok ${c.check}` : `fail ${c.check}: ${c.detail}`)).join('\n')}\n`
      }
      case 'judge': {
        if (!positionals[0] || !positionals[1]) fail('judge needs <judgment-id> <relation>')
        store.judge(positionals[0], positionals[1], { reason: values.reason, evidence: values.evidence, confidence: values.confidence })
        return `judged ${positionals[0]} ${positionals[1]}\n`
      }
      case 'relations': {
        const rows = store.pendingRelations({ limit: values.limit })
        if (values.json) return `${JSON.stringify(rows)}\n`
        return rows.length ? `${rows.map((r) => `${r.judgment_id} #${r.source.id} [${r.source.type}] ${oneLine(r.source.title)} <-> #${r.target.id} [${r.target.type}] ${oneLine(r.target.title)}`).join('\n')}\n` : 'no pending relations\n'
      }
      case 'judge-many':
        return `judged ${store.judgeMany(stdinArray())} relations\n`
      case 'compare': {
        if (positionals.length < 3) fail('compare needs <id-a> <id-b> <relation>')
        const a = idArg(positionals[0])
        const b = idArg(positionals[1])
        if (values.confidence === undefined) fail('compare needs --confidence <0..1>')
        store.compare(a, b, positionals[2], { confidence: values.confidence, reasoning: values.reasoning })
        return `compared #${a} #${b} ${positionals[2]}\n`
      }
      case 'consolidate': {
        if (!values.title) fail('consolidate needs --title <text>')
        const ids = positionals.map(idArg)
        const content = readFileSync(0, 'utf8')
        const input = { title: values.title, content, type: values.type, topic_key: values['topic-key'] }
        const list = ids.map((id) => `#${id}`).join(', ')
        if (values.confirm !== undefined) return `consolidated #${store.consolidate(ids, { ...input, confirm: values.confirm }).id} from ${list}\n`
        const p = store.consolidate(ids, input)
        const flags = `${values.type ? ` --type ${values.type}` : ''}${values['topic-key'] ? ` --topic-key ${values['topic-key']}` : ''}`
        return `${[
          'consolidate preview (nothing written):',
          ...p.sources.map((s) => `  #${s.id} [${s.type}] ${oneLine(s.title)}`),
          `new: ${oneLine(p.title)}`,
          `confirm with: construct-memory consolidate ${ids.join(' ')} --title ${JSON.stringify(p.title)}${flags} --confirm ${p.fingerprint}  (same content on stdin)`,
        ].join('\n')}\n`
      }
      case 'review': {
        if (positionals[0] === 'stale') {
          const rows = store.staleWhere(process.cwd())
          if (values.json) return `${JSON.stringify(rows, null, 2)}\n`
          return rows.length ? `${rows.map((r) => `#${r.id} [${r.type}] ${oneLine(r.title)} - missing: ${r.missing.join(', ')}`).join('\n')}\n` : 'nothing stale\n'
        }
        if (positionals[0] === 'passive') {
          if (values.days !== undefined && !/^[1-9]\d*$/.test(values.days)) fail('review passive --days needs a positive whole number')
          if (values.days !== undefined && Number(values.days) > 36500) fail('review passive --days must be at most 36500')
          const rows = store.passiveUnread({ days: values.days === undefined ? 30 : Number(values.days) })
          if (values.json) return `${JSON.stringify(rows, null, 2)}\n`
          return rows.length ? `${rows.map(hit).join('\n')}\n` : 'no passive rows to review\n'
        }
        if (positionals[0] === 'list') {
          const rows = store.needingReview()
          return rows.length ? `${rows.map(hit).join('\n')}\n` : 'nothing to review\n'
        }
        const id = idArg(positionals[1])
        if (!store.markReviewed(id)) fail(`observation #${id} not found`)
        return `reviewed #${id}\n`
      }
    }
  } finally {
    store.close()
  }
}

try {
  process.stdout.write(await main(process.argv.slice(2)))
} catch (error) {
  // parseArgs errors (unknown option) and store errors (missing title, newer schema) all end here.
  process.stderr.write(`construct-memory: ${oneLine(error.message)}\n`)
  process.exitCode = 1
}
