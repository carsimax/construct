#!/usr/bin/env node
// construct-limits: the orchestrator sets this session's inline edit limit and iteration cap (S3 of .vault/tasks/config-surface.md).
// It writes no state: the limits-record.mjs hook (PreToolUse on Bash) records `set` and reports the active limits (S2 of .vault/tasks/limits-hook.md).
import { CEILINGS, DEFAULTS, parseSet } from '../hooks/scripts/limits.mjs'

const USAGE = `usage: construct-limits <set inline=<N> cap=<N> | show>

  set    declare either or both limits for this session; the other keeps its earlier value; N is a whole number >= 0
  show   the hook reports the active limits as "inline=<N> cap=<N>" in its context

  inline  most lines one main-thread edit call may change (default ${DEFAULTS.inline}, ceiling ${CEILINGS.inline}); 0 means .vault/tasks/ only
  cap     failures of one Bash command before the next run is denied (default ${DEFAULTS.cap}, ceiling ${CEILINGS.cap}); 0 turns the cap off
This command only validates and prints: a hook records the values when the main thread runs set (a subagent's set is ignored and denied).
A value over its ceiling is clamped. Invalid input exits non-zero and records nothing.`

const fail = (message) => {
  process.stderr.write(`construct-limits: ${message}\n`)
  process.exit(1)
}

const [command, ...args] = process.argv.slice(2)
if (command === '--help' || command === '-h' || command === 'help') {
  process.stdout.write(`${USAGE}\n`)
  process.exit(0)
}
if (command === 'show') process.stdout.write('The hook reports the active limits (inline=<N> cap=<N>) in its context when this command runs.\n')
else if (command === 'set') {
  const { values, error } = parseSet(args)
  if (error) fail(`${error}\n${USAGE}`)
  process.stdout.write(`${Object.entries(values).map(([k, v]) => `${k}=${Math.min(v, CEILINGS[k])}`).join(' ')} (the hook records these for the session)\n`)
} else fail(`unknown command ${JSON.stringify(command ?? '')}\n${USAGE}`)
