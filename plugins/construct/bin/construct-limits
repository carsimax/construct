#!/usr/bin/env node
// construct-limits: the orchestrator sets this session's inline edit limit and iteration cap (S3 of .vault/tasks/config-surface.md).
import { CEILINGS, DEFAULTS, readLimits, writeLimits } from '../hooks/scripts/limits.mjs'

const USAGE = `usage: construct-limits <set inline=<N> cap=<N> | show>   (keyed by CLAUDE_CODE_SESSION_ID)

  set    declare either or both limits for this session; the other keeps its earlier value; N is a whole number >= 0
  show   print the active limits as "inline=<N> cap=<N>"

  inline  most lines one main-thread edit call may change (default ${DEFAULTS.inline}, ceiling ${CEILINGS.inline}); 0 means .vault/tasks/ only
  cap     failures of one Bash command before the next run is denied (default ${DEFAULTS.cap}, ceiling ${CEILINGS.cap}); 0 turns the cap off
A value over its ceiling is clamped. Invalid input exits non-zero and changes nothing.`

const fail = (message) => {
  process.stderr.write(`construct-limits: ${message}\n`)
  process.exit(1)
}

const [command, ...args] = process.argv.slice(2)
if (command === '--help' || command === '-h' || command === 'help') {
  process.stdout.write(`${USAGE}\n`)
  process.exit(0)
}
if (command !== 'set' && command !== 'show') fail(`unknown command ${JSON.stringify(command ?? '')}\n${USAGE}`)
const session = process.env.CLAUDE_CODE_SESSION_ID
if (!session) fail('CLAUDE_CODE_SESSION_ID is not set, so the session is unknown')

if (command === 'set') {
  if (args.length === 0) fail(`set needs inline=<N> or cap=<N>\n${USAGE}`)
  const values = {}
  for (const arg of args) {
    const [key, value] = arg.split(/=(.*)/s)
    if (!Object.hasOwn(DEFAULTS, key)) fail(`unknown key ${JSON.stringify(key)} (use inline or cap)`)
    if (!/^(0|[1-9]\d*)$/.test(value ?? '')) fail(`${key} must be a whole number >= 0, got ${JSON.stringify(value ?? '')}`)
    values[key] = Number(value)
  }
  try {
    writeLimits(session, values)
  } catch (error) {
    fail(`cannot save the limits: ${error.message}`)
  }
}
const now = readLimits(session)
process.stdout.write(`inline=${now.inline} cap=${now.cap}\n`)
